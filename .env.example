# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Groq Chat Completions provider. Preferred when configured.
GROQ_API_KEY="YOUR_GROQ_API_KEY"
GROQ_MODEL="openai/gpt-oss-20b"

# Optional xAI Grok Responses API provider. Used when no Groq key is configured.
XAI_API_KEY="YOUR_XAI_API_KEY"
XAI_MODEL="grok-4.7"

# Optional OpenAI Responses API provider used when neither Groq nor xAI is configured.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_MODEL="gpt-6-luna"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://glinnux.github.io/Vault-X/"
# SUPPORT_EMAIL: Default contact email for user complaints or abstract inquiries.
# Users or administrators can configure this address.
SUPPORT_EMAIL="oluwolefaith92@gmail.com"

# Additional Super Admin password factor. Generate an scrypt hash with:
#   node scripts/generate-super-admin-password-hash.mjs
# Copy only the generated scrypt$... hash into your server-side secret manager.
# Never set this to a plaintext password or expose it through a VITE_ variable.
SUPER_ADMIN_PASSWORD_HASH=""

# Generate this hash by running node scripts/generate-super-admin-owner-word-hash.mjs.
# The hidden input must be exactly three letters; only its scrypt hash belongs here.
SUPER_ADMIN_OWNER_WORD_HASH=""

# Public URL of the deployed API used by the GitHub Pages frontend.
VITE_API_BASE_URL="https://vault-x-backend.onrender.com"

# Server-side CORS allow-list. Use origins only, without a path.
APP_ORIGINS="https://glinnux.github.io,http://localhost:3000"

# Must match the Firestore database configured in firebase.json.
FIREBASE_DATABASE_ID="ai-studio-6d74bdaa-298a-415b-917e-593085e6a527"

# Safe to expose in the browser; access is still controlled by signed server URLs.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"

# Server-only. Never prefix this with VITE_ and never commit it.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_your_key_here"
SUPABASE_BUCKET="vault-files"
