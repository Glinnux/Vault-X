# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional xAI Grok Responses API provider. Grok is tried first when configured;
# OpenAI is selected when no Grok key is configured; Gemini is the fallback.
XAI_API_KEY="YOUR_XAI_API_KEY"
XAI_MODEL="grok-4.7"

# Optional OpenAI provider used when XAI_API_KEY is not configured.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_MODEL="gpt-6-luna"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://glinnux.github.io/Vault-X/"
# SUPPORT_EMAIL: Default contact email for user complaints or abstract inquiries.
# Users or administrators can configure this address.
SUPPORT_EMAIL="oluwolefaith92@gmail.com"

# Public URL of the deployed API used by the GitHub Pages frontend.
VITE_API_BASE_URL="https://vault-x-backend.onrender.com"

# Server-side CORS allow-list. Use origins only, without a path.
APP_ORIGINS="https://glinnux.github.io,http://localhost:3000"

# Safe to expose in the browser; access is still controlled by signed server URLs.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"

# Server-only. Never prefix this with VITE_ and never commit it.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_your_key_here"
SUPABASE_BUCKET="vault-files"
