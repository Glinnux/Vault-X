rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAccountBanned(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return exists(userPath) &&
        get(userPath).data.keys().hasAny(['isBanned']) &&
        get(userPath).data.isBanned == true;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email != null && (
        request.auth.token.email.lower() == 'oluwolefaith92@gmail.com' ||
        request.auth.token.email.lower() == 'faitholuwole6@gmail.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function hasAdminPermission(permission) {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.permissions[permission] == true
      );
    }

    function canViewUserDirectory() {
      return isSuperAdmin() ||
        hasAdminPermission('viewFullUserInfo') ||
        hasAdminPermission('giveSlots') ||
        hasAdminPermission('banUsers') ||
        hasAdminPermission('addAdmins');
    }

    function isSafeSelfProfileCreate(data) {
      return data.keys().hasOnly([
          'userId', 'email', 'displayName', 'photoURL', 'role', 'plan',
          'extraSlots', 'maxCredentialSlots', 'createdAt', 'updatedAt'
        ]) &&
        data.role == 'user' &&
        data.plan == 'free' &&
        data.extraSlots == 0 &&
        data.maxCredentialSlots == 10;
    }

    // 3. UserProfile Entity Validator
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'plan', 'planDuration', 'extraSlots', 'maxCredentialSlots', 'paymentStatus', 'paymentRef', 'paymentCurrency', 'senderName', 'bankUsed', 'role', 'approvedAt', 'expiresAt', 'isExpired', 'isBanned', 'bannedReason', 'bannedAt', 'bannedBy', 'createdAt', 'updatedAt']) &&
        data.userId is string && (data.userId == request.auth.uid || isAdmin()) &&
        data.email is string && data.email.size() <= 320 &&
        (!(data.keys().hasAny(['displayName'])) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!(data.keys().hasAny(['photoURL'])) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!(data.keys().hasAny(['plan'])) || (data.plan in ['free', 'paid', 'unlimited', 'biweekly', 'monthly', 'yearly'])) &&
        (!(data.keys().hasAny(['planDuration'])) || (data.planDuration in ['biweekly', 'monthly', 'yearly'])) &&
        (!(data.keys().hasAny(['extraSlots'])) || (data.extraSlots is number && data.extraSlots >= 0 && data.extraSlots <= 999999)) &&
        (!(data.keys().hasAny(['maxCredentialSlots'])) || (data.maxCredentialSlots is number && data.maxCredentialSlots >= 0 && data.maxCredentialSlots <= 999999)) &&
        (!(data.keys().hasAny(['approvedAt'])) || (data.approvedAt is number)) &&
        (!(data.keys().hasAny(['expiresAt'])) || (data.expiresAt is number)) &&
        (!(data.keys().hasAny(['isExpired'])) || (data.isExpired is bool)) &&
        (!(data.keys().hasAny(['isBanned'])) || (data.isBanned is bool)) &&
        (!(data.keys().hasAny(['bannedReason'])) || (data.bannedReason is string && data.bannedReason.size() <= 500)) &&
        (!(data.keys().hasAny(['bannedBy'])) || (data.bannedBy is string && data.bannedBy.size() <= 120)) &&
        (!(data.keys().hasAny(['paymentStatus'])) || (data.paymentStatus in ['none', 'pending', 'verified'])) &&
        (!(data.keys().hasAny(['paymentRef'])) || (data.paymentRef is string && data.paymentRef.size() <= 200)) &&
        (!(data.keys().hasAny(['paymentCurrency'])) || (data.paymentCurrency in ['USD', 'NGN'])) &&
        (!(data.keys().hasAny(['senderName'])) || (data.senderName is string && data.senderName.size() <= 120)) &&
        (!(data.keys().hasAny(['bankUsed'])) || (data.bankUsed is string && data.bankUsed.size() <= 100)) &&
        (!(data.keys().hasAny(['role'])) || (data.role in ['admin', 'user'])) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVaultItem(data) {
      return data.keys().hasAll(['userId', 'type', 'title', 'category', 'favorite', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'userId', 'type', 'title', 'service', 'username', 'password', 'url', 'category',
          'notes', 'imageUrl', 'imageName', 'imageSize', 'imageType', 'imageIv', 'encryptedData', 'favorite', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.type in ['credential', 'document'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.category in ['social', 'work', 'personal', 'finance', 'document', 'other'] &&
        data.favorite is bool &&
        data.createdAt is timestamp && data.updatedAt is timestamp &&
        data.get('service', '') is string && data.get('service', '').size() <= 100 &&
        (!(data.keys().hasAny(['username'])) || (data.username is string && data.username.size() <= 320)) &&
        (!(data.keys().hasAny(['password'])) || (data.password is string && data.password.size() <= 500)) &&
        (!(data.keys().hasAny(['url'])) || (data.url is string && data.url.size() <= 1024)) &&
        (!(data.keys().hasAny(['notes'])) || (data.notes is string && data.notes.size() <= 5000)) &&
        (!(data.keys().hasAny(['imageUrl'])) || (data.imageUrl is string && data.imageUrl.size() <= 2048)) &&
        (!(data.keys().hasAny(['imageName'])) || (data.imageName is string && data.imageName.size() <= 255)) &&
        (!(data.keys().hasAny(['imageSize'])) || (data.imageSize is number && data.imageSize >= 0 && data.imageSize <= 52428800)) &&
        (!(data.keys().hasAny(['imageType'])) || (data.imageType is string && data.imageType.size() <= 100)) &&
        (!(data.keys().hasAny(['imageIv'])) || (data.imageIv is string && data.imageIv.size() == 16)) &&
        (!(data.keys().hasAny(['encryptedData'])) || (
          data.encryptedData is map &&
          data.title == 'Encrypted item' &&
          !(data.keys().hasAny(['service', 'username', 'password', 'url', 'notes', 'imageName'])) &&
          data.encryptedData.keys().hasOnly(['version', 'iv', 'ciphertext']) &&
          data.encryptedData.version == 1 &&
          data.encryptedData.iv is string && data.encryptedData.iv.size() == 16 &&
          data.encryptedData.ciphertext is string && data.encryptedData.ciphertext.size() <= 100000
        ));
    }

    // 4. SupportTicket Entity Validator
    function isValidSupportTicket(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'type', 'subject', 'message', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'userEmail', 'userName', 'type', 'subject', 'message', 'status', 'isRedirectedToOwner', 'redirectedBy', 'redirectedAt', 'adminNotes', 'createdAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.userEmail is string && data.userEmail.size() <= 320 &&
        (!(data.keys().hasAny(['userName'])) || (data.userName is string && data.userName.size() <= 120)) &&
        data.type in ['suggestion', 'complaint', 'inquiry', 'payment'] &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 200 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 5000 &&
        (!(data.keys().hasAny(['status'])) || data.status in ['pending', 'reviewed', 'resolved']) &&
        (!(data.keys().hasAny(['isRedirectedToOwner'])) || data.isRedirectedToOwner is bool) &&
        (!(data.keys().hasAny(['redirectedBy'])) || (data.redirectedBy is string && data.redirectedBy.size() <= 120)) &&
        (!(data.keys().hasAny(['adminNotes'])) || (data.adminNotes is string && data.adminNotes.size() <= 2000)) &&
        data.createdAt is timestamp;
    }

    // 5. Users Collection: User directory
    match /users/{userId} {
      allow list: if canViewUserDirectory();
      allow get: if (isOwner(userId) || canViewUserDirectory()) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        (isAdmin() || isSafeSelfProfileCreate(incoming())) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'updatedAt'
          ])) ||
          isSuperAdmin() ||
          (hasAdminPermission('giveSlots') && incoming().diff(existing()).affectedKeys().hasOnly([
            'plan', 'planDuration', 'extraSlots', 'maxCredentialSlots', 'paymentStatus',
            'paymentRef', 'paymentCurrency', 'approvedAt', 'expiresAt', 'isExpired', 'updatedAt'
          ])) ||
          (hasAdminPermission('banUsers') && incoming().diff(existing()).affectedKeys().hasOnly([
            'isBanned', 'bannedReason', 'bannedAt', 'bannedBy', 'updatedAt'
          ]))
        ) &&
        // Unbanning rule: if account is currently banned, only superadmin can unban it!
        (!existing().keys().hasAny(['isBanned']) || existing().isBanned == false || incoming().isBanned == true || isSuperAdmin());
      allow delete: if false;

      match /security/{securityDoc} {
        allow get, create, update: if isOwner(userId) && !isAccountBanned(userId) && securityDoc == 'vaultKey';
        allow list, delete: if false;
      }

      // 6. Zero-Knowledge Private Vault: strictly isolated per user (blocked if banned)
      match /vault/{itemId} {
        allow get, delete: if isOwner(userId) && !isAccountBanned(userId) && isValidId(userId) && isValidId(itemId);
        allow list: if isOwner(userId) && !isAccountBanned(userId);
        allow create: if isOwner(userId) && !isAccountBanned(userId) && isValidId(userId) && isValidId(itemId) &&
          isValidVaultItem(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && !isAccountBanned(userId) && isValidId(userId) && isValidId(itemId) &&
          isValidVaultItem(incoming()) && incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      }
    }

    // 7. Support Tickets Collection
    match /support_tickets/{ticketId} {
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) ||
        hasAdminPermission('answerComplaints') || hasAdminPermission('redirectSuggestions');
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) ||
        hasAdminPermission('answerComplaints') || hasAdminPermission('redirectSuggestions');
      allow create: if isSignedIn() && isValidId(ticketId) &&
        isValidSupportTicket(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if isValidId(ticketId) && (
        (hasAdminPermission('answerComplaints') && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        (hasAdminPermission('redirectSuggestions') && incoming().diff(existing()).affectedKeys().hasOnly([
          'isRedirectedToOwner', 'redirectedBy', 'adminNotes', 'updatedAt'
        ]))
      );
      allow delete: if isSuperAdmin() && isValidId(ticketId);
    }

    // 8. Administrators Collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && (
        request.auth.uid == adminId ||
        isSuperAdmin() ||
        hasAdminPermission('addAdmins')
      );
      allow create, update, delete: if hasAdminPermission('addAdmins');
    }

    // 9. Administrator conversations
    match /admin_chats/{chatId} {
      function canAccessChat() {
        return isSuperAdmin() || (
          isAdmin() && request.auth.uid in resource.data.participantIds
        );
      }

      allow get, list: if canAccessChat();
      allow create: if isAdmin() &&
        request.auth.uid in incoming().participantIds &&
        incoming().type in ['group', 'dm'] &&
        incoming().participantIds is list &&
        incoming().participantIds.size() >= 2 &&
        incoming().participantIds.size() <= 100 &&
        (incoming().type == 'dm' && incoming().participantIds.size() == 2 ||
         incoming().type == 'group' && isSuperAdmin());
      allow update: if canAccessChat() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'lastMessagePreview']);
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        function canAccessParentChat() {
          let chat = get(/databases/$(database)/documents/admin_chats/$(chatId));
          return isSuperAdmin() || (
            isAdmin() && request.auth.uid in chat.data.participantIds
          );
        }

        allow get, list: if canAccessParentChat();
        allow create: if canAccessParentChat() &&
          incoming().senderId == request.auth.uid &&
          incoming().text is string && incoming().text.size() >= 1 && incoming().text.size() <= 2000 &&
          incoming().createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
